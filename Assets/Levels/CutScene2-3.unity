--- !u!114 &225434159
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 225434158}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35ba00c55b911e74a94ad8de42ebed58, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialoguePanel: {fileID: 345416691}
  portraitPlayer1: {fileID: 116651863}
  portraitPlayer2: {fileID: 1151652055}
  portraitDeer: {fileID: 1552570361}
  nameText: {fileID: 1342393914}
  dialogueText: {fileID: 1615088176}
  narrativeText: {fileID: 1093571204}
  mainMenuPanel: {fileID: 0}
  fadeOverlay: {fileID: 3747522}
  playAutomaticallyOnStart: 1
  player1: {fileID: 0}
  player2: {fileID: 0}
  switcher: {fileID: 0}
  lines:
  - lineType: 1
    name: Little Bro
    text: "Big bro\u2026"
  - lineType: 1
    name: Little Bro
    text: Do you smell that?
  - lineType: 0
    name: Big Bro
    text: Smell what?
  - lineType: 1
    name: Little Bro
    text: 'Something rotten. Like old meat... '
  - lineType: 0
    name: Big Bro
    text: 'I don''t smell anything. '
  - lineType: 1
    name: Little Bro
    text: "It\u2019s getting dark. \r\n"
  - lineType: 1
    name: Little Bro
    text: 'Maybe we should head home.  '
  - lineType: 0
    name: Big Bro
    text: 'Not until I get that deer. '
  - lineType: 1
    name: Little Bro
    text: 'Father always said we should leave before nightfall. '
  - lineType: 0
    name: Big Bro
    text: 'Yeah. Father said a lot of things.  '
  - lineType: 1
    name: Little Bro
    text: "He said there is a monster in these woods. \r\n"
  - lineType: 0
    name: Big Bro
    text: "There isn't. \r\n"
  - lineType: 1
    name: Little Bro
    text: "Then what happened to Mom? \n"
  - lineType: 0
    name: Big Bro
    text: "\u2026 \n"
  - lineType: 1
    name: Little Bro
    text: "She went into the woods with father and never came back. \n"
  - lineType: 1
    name: Little Bro
    text: Father said the monster got her.
  - lineType: 0
    name: Big Bro
    text: Father was a liar.
  - lineType: 1
    name: Little Bro
    text: 'But why would he lie? '
  - lineType: 0
    name: Big Bro
    text: "\u2026 "
  - lineType: 1
    name: Little Bro
    text: 'Then you went into the woods with him and you came back hurt. '
  - lineType: 1
    name: Little Bro
    text: "Father never came home. You said he left us but\u2026"
  - lineType: 1
    name: Little Bro
    text: Did you see the monster too?
  - lineType: 0
    name: Big Bro
    text: 'Stop. '
  - lineType: 1
    name: Little Bro
    text: "But\u2014"
  - lineType: 0
    name: Big Bro
    text: 'I said stop. '
  - lineType: 1
    name: Little Bro
    text: '... '
  - lineType: 1
    name: Little Bro
    text: "\u2026Sorry."
  - lineType: 1
    name: Little Bro
    text: 'I just don''t understand. '
  - lineType: 1
    name: Little Bro
    text: 'First Mom disappeared. Then Father. '
  - lineType: 1
    name: Little Bro
    text: 'Why would they leave us behind? '
  - lineType: 1
    name: Little Bro
    text: '...Big bro? '
  - lineType: 0
    name: Big Bro
    text: ' ... '
  - lineType: 3
    name: 
    text: 'Stomach growls. '
  - lineType: 0
    name: Big Bro
    text: We're hungry.
  - lineType: 0
    name: Big Bro
    text: That's all that matters right now.
  - lineType: 0
    name: Big Bro
    text: That deer is the first decent meal we've seen in weeks.
  - lineType: 0
    name: Big Bro
    text: We're not leaving without it.
  - lineType: 1
    name: Little Bro
    text: ...
  - lineType: 1
    name: Little Bro
    text: Okay.
  - lineType: 1
    name: Little Bro
    text: 'Sorry, big bro. '
  loadNextLevelOnEnd: 1

  dialoguePanel: {fileID: 799907681}
  portraitPlayer1: {fileID: 2004993053}
  portraitPlayer2: {fileID: 2004993052}
  nameText: {fileID: 2004993051}
  dialogueText: {fileID: 2004993050}
  narrativeText: {fileID: 2004993049}
  mainMenuPanel: {fileID: 4082614824544854105}
  fadeOverlay: {fileID: 1064468137}
  playAutomaticallyOnStart: 1
  player1: {fileID: 0}
  player2: {fileID: 0}
  switcher: {fileID: 0}
  lines:
  - lineType: 3
    name: 
    text: Rustle. Rustle.
  - lineType: 0
    name: Big Bro
    text: Hurry up! We're almost there.
  - lineType: 1
    name: Little Bro
    text: huff... huff... Wait for me, big bro!
  - lineType: 0
    name: Big Bro
    text: Can't believe we've gone a whole week without catching anything. Not even
      a rabbit.
  - lineType: 3
    name: 
    text: Stomach growls.
  - lineType: 1
    name: Little Bro
    text: 'Big bro... are you hungry? '
  - lineType: 1
    name: Little Bro
    text: You can have the rest of my snack.
  - lineType: 0
    name: Big Bro
    text: 'No, dummy. Save it. You''re tiny enough already.

'
  - lineType: 1
    name: Little Bro
    text: "...But you haven't eaten anything since\u2014"
  - lineType: 0
    name: Big Bro
    text: 'Shh. '
  - lineType: 0
    name: Big Bro
    text: 'Look. Deer tracks. Luck''s on our side for once.  '
  - lineType: 0
    name: Big Bro
    text: "Once I bring that deer down\u2026 we\u2019ll have a feast.  "
  - lineType: 1
    name: Little Bro
    text: 'Yay! '
  loadNextLevelOnEnd: 1

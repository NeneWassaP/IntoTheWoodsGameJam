--- !u!114 &1148179739
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1148179738}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35ba00c55b911e74a94ad8de42ebed58, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialoguePanel: {fileID: 1963770908}
  portraitPlayer1: {fileID: 1963770913}
  portraitPlayer2: {fileID: 1963770912}
  portraitDeer: {fileID: 1392438139}
  nameText: {fileID: 1963770911}
  dialogueText: {fileID: 1963770910}
  narrativeText: {fileID: 1963770909}
  mainMenuPanel: {fileID: 0}
  fadeOverlay: {fileID: 694455013}
  playAutomaticallyOnStart: 1
  player1: {fileID: 0}
  player2: {fileID: 0}
  switcher: {fileID: 0}
  lines:
  - lineType: 3
    name: 
    text: 'The deer lifts its head.

'
  - lineType: 3
    name: 
    text: Its eyes lock onto yours.
  - lineType: 2
    name: 
    text: For a moment, neither of you moves.
  - lineType: 3
    name: 
    text: 'It stares.

'
  - lineType: 3
    name: 
    text: Then it bolts.
  - lineType: 0
    name: Big Bro
    text: No!
  - lineType: 4
    name: 
    text: The brothers give chase.
  - lineType: 4
    name: 
    text: Branches snap beneath their feet.
  - lineType: 4
    name: 
    text: The deer stays just out of reach.
  - lineType: 4
    name: 
    text: "Then\u2014"
  - lineType: 4
    name: 
    text: The ground disappears beneath them.
  - lineType: 2
    name: Big Bro & Little Bro
    text: AHHHHHHHH!
  - lineType: 4
    name: 
    text: THUD!
  - lineType: 0
    name: Big Bro
    text: "Ouch\u2026"
  - lineType: 1
    name: Little Bro
    text: "Oww\u2026"
  - lineType: 0
    name: Big Bro
    text: You okay?
  - lineType: 1
    name: Little Bro
    text: " Yeah\u2026 just a scratch"
  - lineType: 1
    name: Little Bro
    text: "Big bro, you\u2019re bleeding?\r\n"
  - lineType: 0
    name: Big Bro
    text: "It\u2019s nothing. "
  - lineType: 0
    name: Big Bro
    text: "Damn it\u2026 the deer got away."
  - lineType: 1
    name: Little Bro
    text: "Are you sure you\u2019re okay? "
  - lineType: 1
    name: Little Bro
    text: You look really pale.
  - lineType: 0
    name: Big Bro
    text: "Where\u2019s my rifle? "
  - lineType: 0
    name: Big Bro
    text: "\u2026Damn, it must\u2019ve fallen when we went over the edge. \r\n"
  - lineType: 0
    name: Big Bro
    text: " That stupid deer! Next time I see it, it\u2019s dead. \r\n"
  - lineType: 0
    name: Big Bro
    text: 'Come on!

'
  loadNextLevelOnEnd: 1
